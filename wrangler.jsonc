{
  "name": "dotme",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // No per-version preview URLs: each would be another live endpoint with the same secrets.
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    // The URL clients connect to; every token is bound to it. .dev.vars overrides it locally.
    "MCP_RESOURCE": "https://dotme.ao-fu.workers.dev/mcp",
    // Private repo holding the preference files; the Worker writes it with the GITHUB_TOKEN secret.
    "GITHUB_REPO": "AFFFPupu/dotme-data"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0b8018ffc4594dc6993fbb0cd23d2853" }]
}
