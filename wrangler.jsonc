// Template config, shared by every install. It holds no account-specific values:
// `npm run configure` merges your gitignored dotme.config.json into it and writes
// wrangler.deploy.jsonc, which `npm run deploy` and `npm run wrangler` use.
// `npm run dev` uses this file as is, with .dev.vars on top. The Deploy to Cloudflare
// button also deploys it as is: KV is created on the first deploy, the Worker answers
// at its own address, and the secrets in .dev.vars.example are asked for in the form.
{
  "name": "dotme",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // No per-version preview URLs: each would be another live endpoint with the same secrets.
  "preview_urls": false,
  "observability": { "enabled": true },
  // MCP_RESOURCE, the URL clients connect to and every token is bound to, and GITHUB_REPO
  // are set from dotme.config.json. Without MCP_RESOURCE the Worker uses the address it
  // was reached at; without GITHUB_REPO it reads the GITHUB_REPO secret.
  "vars": {},
  // Holds OAuth grants, sessions and passkeys. The id is set from dotme.config.json;
  // without one, wrangler creates the namespace on the first deploy and reuses it after.
  // Local development uses a local namespace.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
}
