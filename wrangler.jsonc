{
  "name": "memory-passport-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // The URL clients connect to; every token is bound to it. .dev.vars overrides it locally.
    "MCP_RESOURCE": "https://memory-passport-test.ao-fu.workers.dev/mcp"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0b8018ffc4594dc6993fbb0cd23d2853" }]
}
