{
  "name": "memory-passport-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // The URL clients connect to; every token is bound to it. Set to the deployed URL on deploy.
    "MCP_RESOURCE": "http://localhost:8787/mcp"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_ON_DEPLOY" }]
}
